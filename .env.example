# ------------------------------------------------------------------
# SWG CRM — Automated Email Service
# Copy to `.env` and fill in. Never commit the real `.env`.
# ------------------------------------------------------------------

# --- Sender identity -----------------------------------------------
EMAIL_FROM_NAME="Siddha Yoga Web Services"
EMAIL_USER=customer@siddhayogaweb.com

# --- SMTP transport (used when OAuth2 vars are absent) --------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
# Google App Password (16 chars, no spaces). Not the account password.
EMAIL_PASS=

# --- Google OAuth2 (preferred in production) ------------------------
# When all three are present the service uses OAuth2 and ignores EMAIL_PASS.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
# Optional: override Google's token endpoint. Leave blank for the default.
OAUTH_ACCESS_URL=

# --- Routing --------------------------------------------------------
# Where internal alerts land. Comma-separated.
EMAIL_INTERNAL_RECIPIENTS=ariel@siddhayogaweb.com,omri@siddhayogaweb.com
# Reply-to shown to customers.
EMAIL_REPLY_TO=customer@siddhayogaweb.com

# --- Reliability -----------------------------------------------------
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_MS=500
EMAIL_QUEUE_CONCURRENCY=2

# --- Local testing ----------------------------------------------------
# true = render and log the message, never open an SMTP connection.
EMAIL_DRY_RUN=false
LOG_LEVEL=info

# --- Outbox worker (src/server/runEmailWorker.js) --------------------
# The worker is the only piece of this system that needs the SERVICE ROLE
# key -- it bypasses RLS to read/write email_outbox and email_log regardless
# of who queued the job. Never put this key in swg_crm.html; it only ever
# uses the anon key already there.
SUPABASE_URL=https://jrsefbwmumoadncygjsz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# How often the worker checks for new rows when the outbox was empty (ms).
EMAIL_WORKER_POLL_MS=4000
# Rows claimed per poll / sent in parallel within a batch.
EMAIL_WORKER_BATCH_SIZE=5
EMAIL_WORKER_CONCURRENCY=2
